# 复制为 powercontext.env 后填写（powercontext.env 已被 .gitignore 忽略，勿提交真实值）。
# 生成方式：openssl rand -hex 32
POWERCONTEXT_SERVER_AUTH_ENABLED=true
POWERCONTEXT_SERVER_AUTH_TOKEN=replace-with-a-random-token
POWERCONTEXT_SERVER_CURSOR_SIGNING_SECRET=replace-with-another-random-secret-at-least-32-bytes
POWERCONTEXT_SERVER_LOGGING_FORMAT=json
POWERCONTEXT_SERVER_LOGGING_ACCESS=true
