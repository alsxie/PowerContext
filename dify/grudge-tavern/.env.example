# 作者：FDE WorkMate
# 记仇酒馆脚本使用的环境变量示例。复制为 ~/.grudge-tavern/secrets.env（chmod 600）后填写；
# setup_dify.sh / start_powercontext.sh 会自动写入 DIFY_INIT_PASSWORD 与 POWERCONTEXT_TOKEN。
# 本文件只含占位值，切勿提交真实密钥。

# Dify（setup_dify.sh 默认只绑定 127.0.0.1:18080）
DIFY_URL=http://127.0.0.1:18080
DIFY_INIT_PASSWORD=written-by-setup_dify.sh
DIFY_ADMIN_EMAIL=admin@grudge-tavern.local
DIFY_ADMIN_PASSWORD=replace-with-a-strong-password-8+chars-with-letters-and-digits

# MiniMax（OpenAI 兼容接口，经 Dify 插件 langgenius/openai_api_compatible 接入）
MINIMAX_API_KEY=replace-with-your-minimax-api-key
MINIMAX_OPENAI_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash

# PowerContext（start_powercontext.sh 生成；宿主机地址供 verify/reset 脚本使用）
POWERCONTEXT_TOKEN=written-by-start_powercontext.sh
POWERCONTEXT_HOST_URL=http://127.0.0.1:18765
